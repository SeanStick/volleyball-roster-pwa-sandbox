rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // Collaborative Teams (Multi-User Co-Coaching)
    // -------------------------------------------------------------
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------
    // User Profile & User Team Indexes (Strict User Isolation)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy rosters fallback (Authenticated access only)
    match /volleyball_rosters/{teamId} {
      allow read, write: if request.auth != null;
    }

    // Default deny all unmatched collections for production defense-in-depth
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // Collaborative Teams (Multi-User Co-Coaching)
    // -------------------------------------------------------------
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------
    // User Profile & User Team Indexes
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Legacy rosters fallback
    match /volleyball_rosters/{teamId} {
      allow read, write: if true;
    }

    // Default authenticated access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
